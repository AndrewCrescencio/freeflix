# FreeFlix - Environment Variables
# Copy to .env and fill in your values

# Site Configuration
NUXT_PUBLIC_SITE_URL=https://freeflix.com.br
NUXT_PUBLIC_APP_URL=https://app.freeflix.com.br
NUXT_PUBLIC_CONVERSION_MODE=waitlist  # waitlist | signup_redirect

# Email Provider (choose one)
# Resend
NUXT_LEADS_PROVIDER_KEY=re_xxxxxxxxxxxx
# Brevo (Sendinblue)
# NUXT_LEADS_PROVIDER_KEY=xkeysib-xxxxxxxxxxxx
# Supabase
# NUXT_LEADS_PROVIDER_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Analytics (Plausible)
NUXT_PUBLIC_ANALYTICS_DOMAIN=freeflix.com.br
# Umami alternative
# NUXT_PUBLIC_ANALYTICS_DOMAIN=https://analytics.freeflix.com.br

# Optional: Sentry for error tracking
# NUXT_SENTRY_DSN=https://xxx@sentry.io/xxx