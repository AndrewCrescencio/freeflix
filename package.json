{
  "name": "freeflix",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --project=chromium --grep @a11y",
    "test": "pnpm test:unit && pnpm test:e2e"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.137",
    "@iconify-json/simple-icons": "^1.2.97",
    "@nuxt/fonts": "^0.10.0",
    "@nuxt/image": "^1.8.0",
    "@nuxt/ui": "^4.11.2",
    "@nuxtjs/robots": "^5.0.0",
    "@nuxtjs/sitemap": "^6.0.0",
    "@vueuse/motion": "^2.2.0",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "valibot": "^1.0.0-beta.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^3.14.0",
    "@playwright/test": "^1.48.0",
    "eslint": "^10.11.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "happy-dom": "^15.0.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.0",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@12.6.0",
  "pnpm": {
    "allowedBuildScripts": [
      "sharp"
    ]
  }
